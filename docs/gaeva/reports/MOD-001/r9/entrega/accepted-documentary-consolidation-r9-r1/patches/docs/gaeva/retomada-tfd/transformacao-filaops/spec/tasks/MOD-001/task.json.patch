+    },
+    {
+      "id": "RULE-215",
+      "description": "Permitir conectar Google Drive, selecionar pasta principal, configurar frequência, horário, fuso e retenção, executar backup manual e consultar histórico/falhas.",
+      "source": "docs/gaeva/retomada-tfd/transformacao-filaops/spec/modules/MOD-001/approved-decisions.md; RULE-DEC-15 line 27"
