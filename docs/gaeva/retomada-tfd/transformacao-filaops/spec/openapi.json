{
  "openapi": "3.1.0",
  "info": {
    "title": "GAEVA OS - interfaces NOVAS PROPOSTAS MT-A02r1",
    "version": "1.0.0-draft",
    "description": "Nao implementadas. C01r2 e spec integrada sao normativos. schema valida formato; RBAC, audiencia, estado, idempotencia e transicoes exigem checks de dominio. F1 e aprovacao humana antecedem execucao. reason obrigatorio neste novo API e semanticamente identificado. Sem parametros semanticos adicionais por query/header nao declarados."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/gaeva/commands": {
      "post": {
        "operationId": "submitGaevaCommand",
        "description": "Admite chave por instalacao/ator/acao/operation_id e identidade completa. Mesmo operation_id/acao alvo diferente conflita. Retry exato terminal retorna status/resultado original autorizado, sem novo CAS. Concorrente ou unknown202 referencia mesma operacao. Retencao/consulta conforme data-contracts/C01r2. Nunca emite efeito novo ao consultar.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              },
              "example": {
                "command_schema_version": "1",
                "operation_id": "00000000-0000-4000-8000-000000000001",
                "action": "conversation.close.v1",
                "target": {
                  "type": "conversation",
                  "id": "00000000-0000-4000-8000-000000000002"
                },
                "expected_version": 7,
                "payload": {},
                "reason": "Encerramento solicitado pelo principal autorizado"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso terminal ou replay exato com resultado original e versao de commit; versao corrente pode ser maior",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          },
          "202": {
            "description": "Pendente/resultado desconhecido; acompanhar mesma operacao, nunca reenviar com nova chave",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          },
          "401": {
            "description": "Sessao ausente/invalida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Acao proibida sem revelar objeto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Contexto/operacao fora da audiencia ou inconsistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflito de identidade/versao/capacidade/gate/politica; nenhum novo efeito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Comando invalido nao admitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisicoes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Rejeicao inequivoca do provedor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Integracao indisponivel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/gaeva/operations/{action}/{operation_id}": {
      "get": {
        "operationId": "readOwnOperation",
        "description": "Somente namespace do ator/instalacao autenticados; revalidar acesso ao alvo e campos do resultado original. GET nao aplica comando. Operacao inexistente ou fora de audiencia404.",
        "parameters": [
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "conversation.assume.v1",
                "conversation.close.v1",
                "conversation.return_automation.v1",
                "collaboration.accept.v1",
                "collaboration.decline.v1",
                "opportunity.move.v1",
                "order.advance.v1",
                "quote.publish.v1",
                "file.publish.v1",
                "payment.confirm_manual.v1"
              ]
            }
          },
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado autorizado persistido, nao sucesso inventado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          },
          "401": {
            "description": "Sessao ausente/invalida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Acao proibida sem revelar objeto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Contexto/operacao fora da audiencia ou inconsistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/gaeva/context/{origin_type}/{origin_id}": {
      "get": {
        "operationId": "resolveTypedContext",
        "description": "Somente origem conversation/opportunity; mapa persistido, sem fallback por nome/email. Retorno minimo sem valores financeiros. Ausencia de pedido e null, nao primeiro pedido arbitrario. Contatos usa contexto proprio, nao esta nova rota.",
        "parameters": [
          {
            "name": "origin_type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "conversation",
                "opportunity"
              ]
            }
          },
          {
            "name": "origin_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projecao minima permitida com identidade exata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Context"
                }
              }
            }
          },
          "401": {
            "description": "Sessao ausente/invalida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Acao proibida sem revelar objeto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Contexto/operacao fora da audiencia ou inconsistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
