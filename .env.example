# Optional override: without values, the app uses the official GAEVA project
# configured in src/integrations/supabase/public-config.ts.
# Set BOTH values to use another project (for example, local development/staging).
# Never put service_role keys, sb_secret keys, passwords, or tokens in VITE_*.
# After changing build-time variables or rotating the public key, rebuild the app.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
